
import java.util.*;

public class Task02 {

    public static void main(String[] args) {

        ArrayList<String> arrayList = new ArrayList<>();
        LinkedList<String> linkedList = new LinkedList<>();

        arrayList.add("Song 1");
        arrayList.add("Song 2");
        arrayList.add("Song 3");

        linkedList.add("Song 1");
        linkedList.add("Song 2");
        linkedList.add("Song 3");

        System.out.println("ArrayList: " + arrayList);
        System.out.println("LinkedList: " + linkedList);

        // Adding at the end
        arrayList.add("Song 4");
        linkedList.add("Song 4");

        // Inserting at front
        arrayList.add(0, "New Song");
        linkedList.addFirst("New Song");

        // Removing an element
        arrayList.remove(1);
        linkedList.remove(1);

        // Accessing kth element
        System.out.println("ArrayList Element: " + arrayList.get(2));
        System.out.println("LinkedList Element: " + linkedList.get(2));

        // Iterating
        System.out.println("ArrayList Songs:");
        for (String song : arrayList) {
            System.out.println(song);
        }

        System.out.println("LinkedList Songs:");
        for (String song : linkedList) {
            System.out.println(song);
        }

        // ArrayDeque for Up Next
        ArrayDeque<String> upNext = new ArrayDeque<>();
        upNext.addFirst("Song A");
        upNext.addLast("Song B");
        upNext.addFirst("Song C");

        System.out.println("Up Next Queue: " + upNext);
    }
}
