class ParkingTicket {

    static int ticketCounter = 1000;
    static int totalOccupancy = 0;

    int ticketNo;
    String vehicleNo;

    ParkingTicket(String vehicleNo) {
        this.vehicleNo = vehicleNo;
        ticketNo = ++ticketCounter;
        totalOccupancy++;
    }

    void release() {
        if (vehicleNo != null) {
            totalOccupancy--;
            vehicleNo = null;
        }
    }

    static void showOccupancy() {
        System.out.println(
            "Total Occupancy: " + totalOccupancy
        );
    }

    void display() {
        System.out.println("Ticket: " + ticketNo);
        System.out.println("Vehicle: " + vehicleNo);
    }
}

public class Task05 {
    public static void main(String[] args) {

        ParkingTicket t1 =
            new ParkingTicket("AP01AB1234");

        ParkingTicket t2 =
            new ParkingTicket("AP02CD5678");

        t1.display();
        t2.display();

        ParkingTicket.showOccupancy();

        t1.release();

        ParkingTicket.showOccupancy();

        t1 = null;
        t2 = null;

        System.gc();
    }
}
